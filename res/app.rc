#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AutoWiFi Project"
            VALUE "FileDescription",  "Windows Wi-Fi Automatic 802.1X & Portal Authenticator"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "auto-wifi"
            VALUE "OriginalFilename", "auto-wifi.exe"
            VALUE "ProductName",      "AutoWiFi"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
